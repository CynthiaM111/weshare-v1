# Copy to .env for local sandbox dev:
#   cp .env.example .env
#
# Copy to .env.production before a production EAS build (or set EAS secrets):
#   cp .env.production.example .env.production

# sandbox | production — mobile app mode (NOT SMS provider config):
#   sandbox     → shows test-number hint on sign-in, GPS dev bypass allowed
#   production  → hides hint, real-user UX; use when testing real AT SMS
EXPO_PUBLIC_APP_ENV=sandbox

# true = use ride from/to coords for start/complete (sandbox only; ignored in production)
EXPO_PUBLIC_GPS_DEV_MODE=true

# Internal Play testing only — shows OTP on screen instead of SMS (needs server OTP_DEV_BYPASS=true)
# EXPO_PUBLIC_OTP_DEV_BYPASS=true

# Driver verification photos — enable only on internal/production EAS builds (requires native picker module)
# Leave unset in Expo Go / sandbox: drivers submit plate, model, color only (no rebuild needed)
# EXPO_PUBLIC_DRIVER_PHOTOS=true

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- Phone auth (Africa's Talking via Supabase Send SMS Hook — supabase/config.toml) ---
# AT credentials + hook secret live in Supabase Edge secrets (not in this file).
# Enable Send SMS hook → functions/v1/send-sms. Leave Twilio unset in Dashboard.
#
# FREE dev OTP (Supabase test numbers — Dashboard → Auth → Phone):
#   +250780000001 … +250780000006  →  code 123456
#
# Switching modes (restart Expo: npx expo start -c):
#   Dev + test numbers:  APP_ENV=sandbox, use +250780000001
#   Test real AT SMS:    APP_ENV=production, use your real +250… number
#   Back to dev:         APP_ENV=sandbox
