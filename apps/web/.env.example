# Supabase (same project as mobile app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin driver verification page (/admin/verify-drivers)
ADMIN_VERIFY_CODE=3589
# Optional — defaults to service role key hash; set a long random string in production
# ADMIN_SESSION_SECRET=

# Expected mobile app version shown in admin metrics (match app.json version)
NEXT_PUBLIC_EXPECTED_APP_VERSION=1.0.0
